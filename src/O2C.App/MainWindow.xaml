<Window x:Class="O2C.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:O2C.App"
        Title="OpenToConnect" Icon="O2C.ico"
        Width="380" Height="620" MinWidth="340" MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <!-- ================= Главный экран ================= -->
    <Grid Visibility="{Binding MainVisibility}" Margin="14,6,14,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Название уже в заголовке окна — здесь только настройки -->
      <Button Style="{StaticResource IconButton}" Content="&#xE713;" HorizontalAlignment="Right"
              ToolTip="Настройки" AutomationProperties.Name="Настройки" Click="OnOpenSettingsClick" />

      <!-- Большая кнопка и статус -->
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,12">
        <Button Click="OnToggleClick" IsEnabled="{Binding CanToggleConnection}" ToolTip="{Binding ConnectTooltip}"
                Cursor="Hand" HorizontalAlignment="Center">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Grid Width="116" Height="116">
                <Ellipse x:Name="Ring" Stroke="{Binding StateBrush}" StrokeThickness="4" Fill="Transparent" />
                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="42"
                           Foreground="{Binding StateBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <!-- Значок обновления справа от состояния; ширина-противовес слева держит надпись по центру -->
        <Grid HorizontalAlignment="Center" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="{Binding ActualWidth, ElementName=UpdateButton}" Visibility="{Binding UpdateVisibility}" />
          <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button x:Name="UpdateButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE896;"
                  Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="4,0,0,0" Padding="6"
                  Visibility="{Binding UpdateVisibility}" ToolTip="{Binding UpdateTooltip}"
                  AutomationProperties.Name="Обновить OpenToConnect" Click="OnUpdateClick" />
        </Grid>
        <TextBlock Text="{Binding StateDetails}" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                   TextAlignment="Center" MaxWidth="320" Margin="0,2,0,0" />
      </StackPanel>

      <!-- Недоверенный сертификат -->
      <Border Grid.Row="2" Visibility="{Binding CertPromptVisibility}" Margin="0,0,0,10" Padding="10" CornerRadius="6"
              Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
        <StackPanel>
          <TextBlock TextWrapping="Wrap" FontSize="12">
            <Run Text="Сертификат сервера не доверенный. Отпечаток:" />
            <Run Text="{Binding RejectedCertPin, Mode=OneWay}" FontFamily="Consolas" />
          </TextBlock>
          <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Доверять" Click="OnTrustCertClick" />
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Text="Только если отпечаток подтвердил администратор сервера." />
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Исключения и журнал -->
      <TabControl Grid.Row="3" IsEnabled="{Binding ServiceAvailable}">
        <TabItem Header="Исключения">
          <Grid Margin="0,8,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Строка добавления -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="NewExclusionInput" Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}"
                       KeyDown="OnNewExclusionKeyDown" />
              <TextBlock Text="example.com, 1.2.3.4, *.site.ru" IsHitTestVisible="False" Margin="12,0,0,0"
                         VerticalAlignment="Center" Style="{StaticResource Caption}"
                         Visibility="{Binding NewExclusion, Converter={x:Static local:EmptyToVisibleConverter.Instance}}" />
              <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;" Margin="4,0,0,0"
                      ToolTip="Добавить (Enter)" Click="OnAddExclusionClick" />
              <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE77F;"
                      ToolTip="Вставить списком из буфера обмена" Click="OnPasteExclusionsClick" />
              <Button x:Name="AddAppButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE737;"
                      ToolTip="Добавить программу, папку или российские сети" Click="OnAddAppClick">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Российские сети (@ru)" Click="OnAddRussianClick"
                              ToolTip="Российские подсети и сайты .ru, .su, .рф — напрямую, мимо туннеля" />
                    <Separator />
                    <MenuItem Header="Из запущенных…" Click="OnAddAppRunningClick" />
                    <Separator />
                    <MenuItem Header="Программа (.exe)…" Click="OnAddAppFileClick" />
                    <MenuItem Header="Папка с программами…" Click="OnAddAppFolderClick" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding ExclusionsMessage}" Style="{StaticResource Caption}" Margin="2,4,0,4" />

            <!-- Список -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <Grid>
                <TextBlock Visibility="{Binding EmptyListVisibility}" Style="{StaticResource Caption}" Margin="2,8,0,0"
                           Text="Здесь будут адреса, которые идут напрямую, мимо туннеля. Добавьте IP, подсеть, домен, маску *.домен, программу или российские сети (@ru)." />
                <ItemsControl ItemsSource="{Binding ExclusionRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                              Padding="2,6" ToolTip="{Binding FullTooltip}" Background="Transparent">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Visibility="{Binding IconVisibility}" />
                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Tag}" Foreground="{Binding TagBrush}" FontSize="12"
                                     VerticalAlignment="Center" Margin="8,0" />
                          <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Padding="6"
                                  ToolTip="Удалить" Tag="{Binding Entry}" Click="OnRemoveExclusionClick" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </ScrollViewer>

            <TextBlock Grid.Row="3" Text="{Binding ExclusionsSummary}" Style="{StaticResource Caption}" Margin="2,6,0,0" />
          </Grid>
        </TabItem>

        <TabItem Header="Журнал">
          <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </TabItem>
      </TabControl>
    </Grid>

    <!-- ================= Настройки ================= -->
    <Grid Visibility="{Binding SettingsVisibility}" Margin="14,6,14,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Назад"
                Click="OnCloseSettingsClick" />
        <TextBlock Text="Настройки" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
      </DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
        <StackPanel Margin="2,0,2,0" IsEnabled="{Binding ServiceAvailable}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="Сервер (IP, имя или URL)" />
          <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Style="{StaticResource FieldLabel}" Text="Протокол" />
          <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" HorizontalAlignment="Stretch" />

          <TextBlock Style="{StaticResource FieldLabel}" Text="Логин" />
          <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Style="{StaticResource FieldLabel}" Text="Пароль" />
          <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />
          <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" />

          <TextBlock Style="{StaticResource FieldLabel}" Text="Группа (если сервер спрашивает)" />
          <TextBox Text="{Binding AuthGroup, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Style="{StaticResource FieldLabel}" Text="Отпечаток сертификата сервера" />
          <TextBox Text="{Binding ServerCertPin, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11" />

          <CheckBox Content="Переподключаться при обрыве" IsChecked="{Binding AutoReconnect}" Margin="0,12,0,0" />
          <CheckBox Content="DNS сервера вместо DNS этого компьютера" IsChecked="{Binding UseServerDns}" Margin="0,8,0,0" />
          <TextBlock Style="{StaticResource Caption}" Margin="26,2,0,12"
                     Text="По умолчанию имена разрешает DNS вашей сети, как без подключения. Включите, если внутренние имена есть только в DNS сервера." />

          <DockPanel>
            <Button DockPanel.Dock="Left" Content="Сохранить" Click="OnSaveClick" />
            <TextBlock Text="{Binding SaveMessage}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" />
          </DockPanel>
        </StackPanel>

        <!-- Обновления: работают и без службы -->
        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="2,16,2,0" Padding="0,12,0,0">
          <StackPanel>
            <DockPanel>
              <Button x:Name="CheckUpdateButton" DockPanel.Dock="Right" Content="Проверить обновления"
                      IsEnabled="{Binding CanCheckUpdate}" Click="OnCheckUpdateClick" />
              <TextBlock Text="{x:Static local:MainViewModel.VersionText}" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel Margin="0,6,0,0">
              <Button DockPanel.Dock="Right" Content="Обновить" Visibility="{Binding UpdateVisibility}" Margin="8,0,0,0"
                      Click="OnUpdateClick" />
              <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </DockPanel>
            <CheckBox Content="Проверять обновления автоматически" IsChecked="{Binding AutoUpdateCheck}" Margin="0,8,0,0"
                      Click="OnAutoUpdateCheckClick" />
            <TextBlock Style="{StaticResource Caption}" Margin="26,2,0,0"
                       Text="При запуске окна и раз в 12 часов — один запрос к GitHub, без сведений о компьютере." />
          </StackPanel>
        </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
