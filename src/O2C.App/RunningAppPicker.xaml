<Window x:Class="O2C.App.RunningAppPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:O2C.App"
        Title="Запущенные программы" Icon="O2C.ico"
        Width="420" Height="520" MinWidth="340" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="14,10,14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <TextBox x:Name="FilterInput" TextChanged="OnFilterChanged" />
      <TextBlock x:Name="FilterHint" Text="Поиск по имени или пути" IsHitTestVisible="False" Margin="12,0,0,0"
                 VerticalAlignment="Center" Style="{StaticResource Caption}" />
    </Grid>

    <CheckBox x:Name="ShowBackground" Grid.Row="1" Margin="0,8,0,0" Content="Показать фоновые (без окна, например в области уведомлений)"
              Checked="OnShowBackgroundChanged" Unchecked="OnShowBackgroundChanged" />

    <ListBox x:Name="AppList" Grid.Row="2" Margin="0,8,0,0" MouseDoubleClick="OnListDoubleClick"
             SelectionChanged="OnSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type local:RunningApp}">
          <Grid ToolTip="{Binding Path}" Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1">
              <TextBlock TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="{Binding Description, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </TextBlock>
              <TextBlock Text="{Binding Details}" FontSize="11" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <TextBlock Text="{Binding FolderHint}" Visibility="{Binding FolderHintVisibility}" FontSize="11"
                         TextWrapping="Wrap" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource Caption}" Margin="2,6,0,0"
               Text="Загрузка списка…" />

    <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Обновить список"
              Click="OnRefreshClick" />
      <Button DockPanel.Dock="Right" Content="Отмена" IsCancel="True" Margin="8,0,0,0" MinWidth="90" />
      <Button x:Name="AddFileButton" DockPanel.Dock="Right" Content="Добавить" IsDefault="True" MinWidth="90"
              IsEnabled="False" Click="OnAddFileClick" ToolTip="Добавить эту программу" />
      <Button x:Name="AddFolderButton" DockPanel.Dock="Right" Content="Её папку" Margin="0,0,8,0"
              IsEnabled="False" Click="OnAddFolderClick" />
    </DockPanel>
  </Grid>
</Window>
