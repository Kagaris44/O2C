OpenToConnect: run a native .exe helper directly instead of via cscript.exe.

License: LGPL-2.1-or-later, the same as OpenConnect itself.

openconnect on Windows always starts the vpnc-script through Windows Script Host.
OpenToConnect configures the network with its own helper (OpenToConnect.NetConfig.exe),
so an .exe script is started directly. Behaviour for .js/.vbs scripts is unchanged.

--- a/script.c
+++ b/script.c
@@ -543,4 +543,7 @@
 static const char *script_engine(const char *path) {
 	const char *dot = strrchr(path, '.');
+	/* OpenToConnect: native helper, no Windows Script Host. */
+	if (dot && strcasecmp(dot, ".exe") == 0)
+		return NULL;
 	if (dot && strcasecmp(dot, ".js") == 0)
 		/*
@@ -576,5 +579,8 @@
 	script_setenv(vpninfo, "reason", reason, 0, 0);

-	if (asprintf(&cmd, "%s \"%s\"", script_engine(vpninfo->vpnc_script), vpninfo->vpnc_script) == -1)
+	if (script_engine(vpninfo->vpnc_script)) {
+		if (asprintf(&cmd, "%s \"%s\"", script_engine(vpninfo->vpnc_script), vpninfo->vpnc_script) == -1)
+			return 0;
+	} else if (asprintf(&cmd, "\"%s\"", vpninfo->vpnc_script) == -1)
 		return 0;

